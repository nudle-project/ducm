rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /meta/feed {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /meta/users {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
